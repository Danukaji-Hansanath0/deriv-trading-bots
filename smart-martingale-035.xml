      <block type="variables_set" id="init_stake_set">
        <field name="VAR" id="cV~-Alq}UZ+O~dGM!1Fk">Initial_Stake</field>
        <value name="VALUE">
          <block type="math_number" id="init_stake_num"><field name="NUM">0.35</field></block>
        </value>
        <next>
          <!-- Current_Stake = Initial_Stake -->
          <block type="variables_set" id="curr_stake_set">
            <field name="VAR" id="b{GT|f,n6:nv]_U$%`U2">Current_Stake</field>
            <value name="VALUE">
              <block type="variables_get" id="curr_get_init">
                <field name="VAR" id="cV~-Alq}UZ+O~dGM!1Fk">Initial_Stake</field>
              </block>
            </value>
            <next>
              <!-- Target_Profit = 10 -->
              <block type="variables_set" id="target_set">
                <field name="VAR" id="rlYcT[__d89=3y]{CW+?">Target_Profit</field>
                <value name="VALUE">
                  <block type="math_number" id="target_num"><field name="NUM">10</field></block>
                </value>
                <next>
                  <!-- Stop_Loss = 5 -->
                  <block type="variables_set" id="stoploss_set">
                    <field name="VAR" id="73u7zZ}p:I@`SH|oysA+">Stop_Loss</field>
                    <value name="VALUE">
                      <block type="math_number" id="stoploss_num"><field name="NUM">5</field></block>
                    </value>
                    <next>
                      <!-- Total_Profit = 0 -->
                      <block type="variables_set" id="tp_init">
                        <field name="VAR" id="1]MVFCxN`xPknil1?7u.">Total_Profit</field>
                        <value name="VALUE">
                          <block type="math_number" id="tp_zero"><field name="NUM">0</field></block>
                        </value>
                        <next>
                          <!-- Loss_Count = 0 -->
                          <block type="variables_set" id="lc_init">
                            <field name="VAR" id="GT+e#pM4g%Q[dse0aK`n">Loss_Count</field>
                            <value name="VALUE">
                              <block type="math_number" id="lc_zero"><field name="NUM">0</field></block>
                            </value>
                            <next>
                              <!-- Max_Martingale_Level = 4 (conservative for small stake) -->
                              <block type="variables_set" id="set_max_mart">
                                <field name="VAR" id="Max_Martingale_Level">Max_Martingale_Level</field>
                                <value name="VALUE">
                                  <block type="math_number" id="max_mart_num"><field name="NUM">4</field></block>
                                </value>
                                <next>
                                  <!-- Martingale_Multiplier = 2.0 (standard doubling) -->
                                  <block type="variables_set" id="set_mart_mult">
                                    <field name="VAR" id="Martingale_Multiplier">Martingale_Multiplier</field>
                                    <value name="VALUE">
                                      <block type="math_number" id="mart_mult_num"><field name="NUM">2</field></block>
                                    </value>
                                    <next>
                                      <!-- Daily_Loss_Limit = 8 -->
                                      <block type="variables_set" id="set_daily_loss">
                                        <field name="VAR" id="Daily_Loss_Limit">Daily_Loss_Limit</field>
                                        <value name="VALUE">
                                          <block type="math_number" id="daily_loss_num"><field name="NUM">8</field></block>
