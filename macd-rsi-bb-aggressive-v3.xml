<xml xmlns="http://www.w3.org/1999/xhtml" xmlns:b="https://developers.binary.com/bot/">
  <block type="trade_definition" id="main_trade" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="market_def">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">R_100</field>
        <next>
          <block type="trade_definition_tradetype" id="tradetype_def">
            <field name="TRADETYPECAT_LIST">callput</field>
            <field name="TRADETYPE_LIST">callput</field>
            <next>
              <block type="trade_definition_contracttype" id="contract_def">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="candle_def">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="restart_def">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartaftertick" id="tick_restart">
                            <field name="RESTARTAFTERTICK">false</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="trade_options">
        <mutation has_first_barrier="false" has_second_barrier="false" has_prediction="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION">
          <shadow type="math_number" id="duration_shadow">
            <field name="NUM">2</field>
          </shadow>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number" id="amount_shadow">
            <field name="NUM">0.50</field>
          </shadow>
        </value>
      </block>
    </statement>
  </block>

  <block type="before_purchase" id="before_purchase_block" x="0" y="400">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if" id="init_variables">
        <value name="IF0">
          <block type="logic_compare" id="check_init">
            <field name="OP">EQ</field>
            <value name="A">
              <block type="variables_get" id="get_losscount_init">
                <field name="VAR" variabletype="">LossCount</field>
              </block>
            </value>
            <value name="B">
              <block type="logic_null" id="null_check"></block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="set_initial_losscount">
            <field name="VAR" variabletype="">LossCount</field>
            <value name="VALUE">
              <block type="math_number" id="zero_init">
                <field name="NUM">0</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="set_initial_stake">
                <field name="VAR" variabletype="">CurrentStake</field>
                <value name="VALUE">
                  <block type="math_number" id="initial_stake_val">
                    <field name="NUM">0.50</field>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </statement>
        <next>
          <block type="variables_set" id="update_trade_amount">
            <field name="VAR" variabletype="">Amount</field>
            <value name="VALUE">
              <block type="variables_get" id="get_current_stake">
                <field name="VAR" variabletype="">CurrentStake</field>
              </block>
            </value>
            <next>
      <block type="controls_if" id="signal_check">
        <mutation else="1"></mutation>
        <value name="IF0">
          <block type="logic_operation" id="call_condition">
            <field name="OP">AND</field>
            <value name="A">
              <block type="logic_compare" id="bb_call">
                <field name="OP">GT</field>
                <value name="A">
                  <block type="ticks" id="close_price">
                    <field name="TICKOFFSET">0</field>
                  </block>
                </value>
                <value name="B">
                  <block type="bb" id="bb_middle_call">
                    <field name="BB_INPUT_LIST">close</field>
                    <field name="BB_PERIOD">14</field>
                    <field name="BB_MULTIPLIER">2</field>
                    <field name="BB_FIELD">MID</field>
                  </block>
                </value>
              </block>
            </value>
            <value name="B">
              <block type="logic_operation" id="rsi_macd_call">
                <field name="OP">AND</field>
                <value name="A">
                  <block type="logic_compare" id="rsi_call">
                    <field name="OP">GT</field>
                    <value name="A">
                      <block type="rsi" id="rsi_value_call">
                        <field name="RSI_INPUT_LIST">close</field>
                        <field name="RSI_PERIOD">7</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="math_number" id="rsi_threshold_call">
                        <field name="NUM">48</field>
                      </block>
                    </value>
                  </block>
                </value>
                <value name="B">
                  <block type="logic_compare" id="macd_call">
                    <field name="OP">GT</field>
                    <value name="A">
                      <block type="macd" id="macd_main_call">
                        <field name="MACD_INPUT_LIST">close</field>
                        <field name="MACD_FAST_PERIOD">8</field>
                        <field name="MACD_SLOW_PERIOD">17</field>
                        <field name="MACD_SIGNAL_PERIOD">5</field>
                        <field name="MACD_FIELD">MAIN</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="macd" id="macd_signal_call">
                        <field name="MACD_INPUT_LIST">close</field>
                        <field name="MACD_FAST_PERIOD">8</field>
                        <field name="MACD_SLOW_PERIOD">17</field>
                        <field name="MACD_SIGNAL_PERIOD">5</field>
                        <field name="MACD_FIELD">SIGNAL</field>
                      </block>
                    </value>
                  </block>
                </value>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="purchase" id="purchase_call">
            <field name="PURCHASE_LIST">CALL</field>
          </block>
        </statement>
        <value name="ELSE">
          <block type="controls_if" id="put_condition_wrapper">
            <value name="IF0">
              <block type="logic_operation" id="put_condition">
                <field name="OP">AND</field>
                <value name="A">
                  <block type="logic_compare" id="bb_put">
                    <field name="OP">LT</field>
                    <value name="A">
                      <block type="ticks" id="close_price_put">
                        <field name="TICKOFFSET">0</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="bb" id="bb_middle_put">
                        <field name="BB_INPUT_LIST">close</field>
                        <field name="BB_PERIOD">14</field>
                        <field name="BB_MULTIPLIER">2</field>
                        <field name="BB_FIELD">MID</field>
                      </block>
                    </value>
                  </block>
                </value>
                <value name="B">
                  <block type="logic_operation" id="rsi_macd_put">
                    <field name="OP">AND</field>
                    <value name="A">
                      <block type="logic_compare" id="rsi_put">
                        <field name="OP">LT</field>
                        <value name="A">
                          <block type="rsi" id="rsi_value_put">
                            <field name="RSI_INPUT_LIST">close</field>
                            <field name="RSI_PERIOD">7</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="math_number" id="rsi_threshold_put">
                            <field name="NUM">52</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <value name="B">
                      <block type="logic_compare" id="macd_put">
                        <field name="OP">LT</field>
                        <value name="A">
                          <block type="macd" id="macd_main_put">
                            <field name="MACD_INPUT_LIST">close</field>
                            <field name="MACD_FAST_PERIOD">8</field>
                            <field name="MACD_SLOW_PERIOD">17</field>
                            <field name="MACD_SIGNAL_PERIOD">5</field>
                            <field name="MACD_FIELD">MAIN</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="macd" id="macd_signal_put">
                            <field name="MACD_INPUT_LIST">close</field>
                            <field name="MACD_FAST_PERIOD">8</field>
                            <field name="MACD_SLOW_PERIOD">17</field>
                            <field name="MACD_SIGNAL_PERIOD">5</field>
                            <field name="MACD_FIELD">SIGNAL</field>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="purchase" id="purchase_put">
                <field name="PURCHASE_LIST">PUT</field>
              </block>
            </statement>
          </block>
        </value>
      </block>
    </statement>
  </block>

  <block type="after_purchase" id="after_purchase_block" x="0" y="800">
    <statement name="AFTERPURCHASE_STACK">
      <block type="variables_set" id="set_result">
        <field name="VAR" variabletype="">Result</field>
        <value name="VALUE">
          <block type="contract_check_result" id="check_result">
            <field name="CHECK_RESULT">win</field>
          </block>
        </value>
        <next>
          <block type="controls_if" id="win_loss_check">
            <mutation else="1"></mutation>
            <value name="IF0">
              <block type="logic_compare" id="is_win">
                <field name="OP">EQ</field>
                <value name="A">
                  <block type="variables_get" id="get_result">
                    <field name="VAR" variabletype="">Result</field>
                  </block>
                </value>
                <value name="B">
                  <block type="logic_boolean" id="true_val">
                    <field name="BOOL">TRUE</field>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="variables_set" id="reset_stake_win">
                <field name="VAR" variabletype="">CurrentStake</field>
                <value name="VALUE">
                  <block type="math_number" id="initial_stake">
                    <field name="NUM">0.50</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="reset_loss_count">
                    <field name="VAR" variabletype="">LossCount</field>
                    <value name="VALUE">
                      <block type="math_number" id="zero_loss">
                        <field name="NUM">0</field>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="math_change" id="increment_loss">
                <field name="VAR" variabletype="">LossCount</field>
                <value name="DELTA">
                  <block type="math_number" id="one_inc">
                    <field name="NUM">1</field>
                  </block>
                </value>
                <next>
                  <block type="controls_if" id="martingale_calc">
                    <value name="IF0">
                      <block type="logic_compare" id="check_max_loss">
                        <field name="OP">LTE</field>
                        <value name="A">
                          <block type="variables_get" id="get_loss_count">
                            <field name="VAR" variabletype="">LossCount</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="math_number" id="max_steps">
                            <field name="NUM">5</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="variables_set" id="calc_martingale">
                        <field name="VAR" variabletype="">CurrentStake</field>
                        <value name="VALUE">
                          <block type="math_arithmetic" id="martingale_mult">
                            <field name="OP">MULTIPLY</field>
                            <value name="A">
                              <block type="variables_get" id="get_current_stake">
                                <field name="VAR" variabletype="">CurrentStake</field>
                              </block>
                            </value>
                            <value name="B">
                              <block type="math_number" id="multiplier">
                                <field name="NUM">2.1</field>
                              </block>
                            </value>
                          </block>
                        </value>
                      </block>
                    </statement>
                    <next>
                      <block type="controls_if" id="reset_after_max">
                        <value name="IF0">
                          <block type="logic_compare" id="check_reset">
                            <field name="OP">GT</field>
                            <value name="A">
                              <block type="variables_get" id="get_loss_count_reset">
                                <field name="VAR" variabletype="">LossCount</field>
                              </block>
                            </value>
                            <value name="B">
                              <block type="math_number" id="max_limit">
                                <field name="NUM">5</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <statement name="DO0">
                          <block type="variables_set" id="hard_reset">
                            <field name="VAR" variabletype="">CurrentStake</field>
                            <value name="VALUE">
                              <block type="math_number" id="reset_stake_val">
                                <field name="NUM">0.50</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="reset_loss_counter">
                                <field name="VAR" variabletype="">LossCount</field>
                                <value name="VALUE">
                                  <block type="math_number" id="zero_reset">
                                    <field name="NUM">0</field>
                                  </block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </statement>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </statement>
            <next>
              <block type="notify" id="trade_result_notify">
                <field name="NOTIFICATION_TYPE">info</field>
                <field name="NOTIFICATION_SOUND">silent</field>
                <value name="MESSAGE">
                  <block type="text_join" id="result_message">
                    <mutation items="4"></mutation>
                    <value name="ADD0">
                      <block type="text" id="text_result">
                        <field name="TEXT">Result: </field>
                      </block>
                    </value>
                    <value name="ADD1">
                      <block type="variables_get" id="get_result_msg">
                        <field name="VAR" variabletype="">Result</field>
                      </block>
                    </value>
                    <value name="ADD2">
                      <block type="text" id="text_stake">
                        <field name="TEXT"> | Stake: $</field>
                      </block>
                    </value>
                    <value name="ADD3">
                      <block type="variables_get" id="get_stake_msg">
                        <field name="VAR" variabletype="">CurrentStake</field>
                      </block>
                    </value>
                  </block>
                </value>
                <next>
                  <block type="trade_again" id="continue_trading"></block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>